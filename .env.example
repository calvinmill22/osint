# Local ADS-B / OSINT tracker configuration.
# Provide your own values in a local .env file (do not commit .env).

# Optional OpenSky credentials.
# Leave blank to disable metadata enrichment.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=

# SBS/BaseStation feed from local dump1090-fa or readsb.
ADSB_HOST=127.0.0.1
ADSB_PORT=30003

# Your own receiver location (required for map centering/range logic).
# Do not commit your actual coordinates to the repository.
RECEIVER_LAT=
RECEIVER_LON=
